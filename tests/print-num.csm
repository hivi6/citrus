# This program prints a number
main:
	INST_LOAD_CONST r3 1000123123
	INST_CALL       printNum

	INST_HLT

# Print the number in decimal format
# arg0 = r3
printNum:
	INST_PUSH r3
	INST_CALL numLength
	INST_POP  r5

	INST_PUSH r5
	INST_PUSH r4

	INST_LOAD r3 r5 8
	INST_CALL reverseNum

	INST_POP  r4
	INST_POP  r5

	INST_LOAD r5 r3 8

printNumLoopStart:
	INST_LOAD_CONST r6 10
	INST_MOD        r3 r5 r6
	INST_DIV        r5 r5 r6

	INST_PUSH r3
	INST_PUSH r4
	INST_PUSH r5

	INST_LOAD_CONST r6 48
	INST_ADD        r3 r3 r6
	INST_CALL       printChar

	INST_POP r5
	INST_POP r4
	INST_POP r3

	INST_LOAD_CONST r6 1
	INST_SUB        r4 r4 r6

	INST_JMP_TRUE   r4 printNumLoopStart

	INST_LOAD_CONST r3 10
	INST_CALL       printChar

	INST_RET

# Get the length of the number
# arg0 = r3
# ret  = r4
numLength:
	INST_LOAD_CONST r4 0
	INST_LOAD_CONST r5 1
	INST_LOAD_CONST r6 10

numLengthLoopStart:
	INST_DIV       r3 r3 r6
	INST_ADD       r4 r4 r5
	INST_JMP_TRUE  r3 numLengthLoopStart

	INST_RET

# Get the reverse of the number
# arg0 = r3
# ret  = r3
reverseNum:
	INST_LOAD_CONST r4 0
	INST_LOAD_CONST r5 10

reverseNumLoopStart:
	INST_MOD r6 r3 r5
	INST_DIV r3 r3 r5

	INST_MUL r4 r4 r5 
	INST_ADD r4 r4 r6

	INST_JMP_TRUE r3 reverseNumLoopStart

	INST_LOAD r3 r4 8

	INST_RET


# Print one character
# arg0 = r3
printChar:
	INST_LOAD        r2 r1 8
	INST_LOAD_CONST  r10 1
	INST_SUB         r2 r2 r10

	INST_LOAD            r4 r3 8
	INST_STORE_INDIRECT  r2 r4 1

	INST_LOAD_CONST      r4 0
	INST_LOAD            r5 r2 8
	INST_LOAD_CONST      r6 1
	INST_SYSCALL         1

	INST_RET

