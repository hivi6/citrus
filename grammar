Rules:
	- All whitespace except newline is ignored

// ========================================
// TOKENS
// ========================================

NEWLINE := "\n"

COLON := ":"

IDENTIFIER      := [a-zA-Z_][0-9a-zA-Z_]*
INT_LITERAL     := "0" | [1-9][0-9]*

// ========================================
// GRAMMAR
// ========================================

<prog>     := <stmt>*
<stmt>     := (<label> | <inst>) NEWLINE
<label>    := IDENTIFIER COLON
<inst>     := IDENTIFIER (IDENTIFIER | INT_LITERAL){0, 3}

